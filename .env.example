# Postgres (Neon-compatible). Phase 0 has no real DB; the app uses an in-memory store.
# When ready to persist data: provision Neon → paste connection string → `npx prisma migrate dev`.
DATABASE_URL="postgresql://user:password@host:5432/staymini?sslmode=require"

# Resend API key for outbound notification emails (scaffolded only, not wired up yet).
RESEND_API_KEY=""

# Required if/when Auth.js (NextAuth) is added to protect /admin.
NEXTAUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"

# 藍新金流 / ECPay (國內信用卡 / ATM / 超商)
ECPAY_MERCHANT_ID=
ECPAY_HASH_KEY=
ECPAY_HASH_IV=
ECPAY_ENV=stage

# Stripe (國際訂閱 / 抽成)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

NEXT_PUBLIC_SITE_URL=http://localhost:3000
