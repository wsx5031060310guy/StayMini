# Postgres (Neon-compatible). Phase 0 has no real DB; the app uses an in-memory store.
# When ready to persist data: provision Neon → paste connection string → `npx prisma migrate dev`.
DATABASE_URL="postgresql://user:password@host:5432/staymini?sslmode=require"

# Mailgun for outbound notification emails (scaffolded only, not wired up yet).
# When ready: call POST https://api.{region}.mailgun.net/v3/{domain}/messages with API key.
MAILGUN_API_KEY=""
MAILGUN_DOMAIN=""
MAILGUN_FROM_EMAIL=""
MAILGUN_FROM_NAME=""
MAILGUN_REGION="api.mailgun.net"

# Required if/when Auth.js (NextAuth) is added to protect /admin.
NEXTAUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"

# 藍新金流 (NewebPay) — 國內信用卡 / ATM / 超商
NEWEBPAY_MERCHANT_ID=
NEWEBPAY_HASH_KEY=
NEWEBPAY_HASH_IV=
NEWEBPAY_API_BASE=https://core.newebpay.com

NEXT_PUBLIC_SITE_URL=http://localhost:3000
