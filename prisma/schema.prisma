// StayMini — minimal B&B / minsu landing site + booking inquiry.
// Phase 0: schema declared but not migrated. App reads/writes an in-memory store
// in src/lib until Mike provisions Postgres (Neon) and runs `prisma migrate dev`.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Inquiry {
  id        String   @id @default(cuid())
  name      String
  phone     String?
  email     String?
  checkIn   DateTime
  checkOut  DateTime
  guests    Int
  roomSlug  String?
  message   String?  @db.Text
  status    String   @default("new") // new | contacted | confirmed | cancelled
  createdAt DateTime @default(now())

  @@index([status])
  @@index([createdAt])
}

model Room {
  id            String   @id @default(cuid())
  slug          String   @unique
  name          String
  capacity      Int
  pricePerNight Int
  description   String?  @db.Text
  amenities     String[]
  imageUrl      String?
  createdAt     DateTime @default(now())
}

model Booking {
  id           String        @id @default(cuid())
  roomSlug     String
  guestName    String
  guestEmail   String?
  guestPhone   String?
  checkIn      DateTime
  checkOut     DateTime
  guests       Int
  totalAmount  Int
  commission   Int
  payoutAmount Int
  status       BookingStatus @default(HELD)
  orders       Order[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([roomSlug])
  @@index([status])
  @@index([checkIn])
}

model Order {
  id              String        @id @default(cuid())
  merchantTradeNo String        @unique
  bookingId       String?
  booking         Booking?      @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  planCode        String
  amount          Int
  currency        String        @default("TWD")
  provider        OrderProvider
  providerRef     String?
  status          OrderStatus   @default(PENDING)
  customerEmail   String?
  rawCallback     Json?
  paidAt          DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([status])
  @@index([planCode])
  @@index([bookingId])
}

enum BookingStatus {
  HELD
  CONFIRMED
  CANCELLED
  NO_SHOW
  COMPLETED
}

enum OrderProvider {
  ECPAY
  STRIPE
}

enum OrderStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}
